# ---------- Banco ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/milly"
# Banco usado pelos testes (o nome precisa conter "test")
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/milly_test"

# ---------- Aplicação ----------
APP_URL="http://localhost:3000"
DEFAULT_TENANT_SLUG="milly-rodrigues"
# O painel usa e-mail e senha. Cadastre a gestora com:
#   npm run staff:create -- --email gestora@exemplo.com --name "Nome da gestora"

# ---------- Login Google das clientes (Auth.js) ----------
# Gere com: npx auth secret  (ou openssl rand -base64 32)
AUTH_SECRET=""
# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------- Fila de mensagens ----------
# Segredo para o cron chamar POST /api/cron/outbox
CRON_SECRET=""
WORKER_INTERVAL_MS="30000"

# ---------- E-mail ----------
# "console" (só registra no log) ou "resend"
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Milly Rodrigues <agendamento@seu-dominio.com.br>"

# ---------- WhatsApp Business Platform (Cloud API oficial) ----------
WHATSAPP_ENABLED="false"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_LANG="pt_BR"
